                     "id":  2,
                     "documentId":  "ds99u5tk2o74ik382a3i1cai",
                     "title":  "From coconut husk to growing media",
                     "slug":  "coconut-husk-to-growing-media",
                     "summary":  "A look at how responsibly processed coir becomes a reliable growing medium.",
                     "content":  [
                                     {
                                         "type":  "paragraph",
                                         "children":  [
                                                          {
                                                              "type":  "text",
                                                              "text":  "A coconut husk has a second life after harvest. Its fibres and pith can be processed into a versatile growing medium for professional growers."
                                                          }
                                                      ]
                                     },
                                     {
                                         "type":  "heading",
                                         "level":  2,
                                         "children":  [
                                                          {
                                                              "type":  "text",
                                                              "text":  "Prepared for consistent growth"
                                                          }
                                                      ]
                                     },
                                     {
                                         "type":  "paragraph",
                                         "children":  [
                                                          {
                                                              "type":  "text",
                                                              "text":  "Washing, screening and careful grading help produce coir with dependable structure. The right blend supports aeration, moisture retention and easier handling."
                                                          }
                                                      ]
                                     }
                                 ],
                     "createdAt":  "2026-10-22T14:01:35.939Z",
                     "updatedAt":  "2026-10-22T14:01:35.939Z",
