# Resend API key – server-only, never expose to the client
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Verified sender address on your Resend domain
EMAIL_FROM=noreply@yourdomain.com

# Where quote/enquiry emails should be delivered
EMAIL_TO=you@yourdomain.com

# Your production domain (used for CORS / origin check)
ALLOWED_ORIGIN=https://yourdomain.com

# Private article admin credentials. Runtime authentication uses the scrypt hash, not ADMIN_PASSWORD.
# Generate a local hash with `npm run admin:hash`; set the hash and stable session secret on the host.
ADMIN_EMAIL=mohan@arjunaexports.com
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
BLOG_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Temporarily set true to return separate wrong-email and wrong-password messages while debugging.
ADMIN_AUTH_DEBUG_ERRORS=false

# SQLite database and uploaded images persist in this directory.
BLOG_DATA_DIR=./data
