                                      "documentId":  "rj5risl22gak31pdxw823wss",
                                      "name":  "Growing media",
                                      "slug":  "growing-media",
                                      "createdAt":  "2026-10-22T14:01:35.919Z",
                                      "updatedAt":  "2026-10-22T14:01:35.919Z",
